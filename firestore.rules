rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validNick(n) {
      return n is string && n.size() >= 1 && n.size() <= 20
        && !n.matches('.*[\\s/\\\\.#$\\[\\]].*');
    }
    function validRecord() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nick', 'score', 'achievedAt'])
        && d.keys().hasAll(['nick', 'score', 'achievedAt'])
        && validNick(d.nick)
        && d.score is int && d.score >= 0 && d.score <= 1000000
        && d.achievedAt == request.time;
    }

    // 한 사람(익명 uid)당 최고기록 1개. 닉네임은 다른 사람과 겹쳐도 됨.
    match /scores/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid && validRecord();
      allow update: if signedIn() && request.auth.uid == uid && (
        (validRecord() && request.resource.data.score > resource.data.score)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nick'])
            && validNick(request.resource.data.nick))
      );
      allow delete: if false;
    }

    // 예전 닉네임 예약 문서: 이제 쓰지 않음 (읽기·본인 삭제만 허용)
    match /nicknames/{name} {
      allow read: if true;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
